# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# DeepSeek API Keys (Primary - Required)
SMG-Forcer-API=sk-your-deepseek-api-key-here

# DeepSeek API Keys (Backup - Optional)
DEEPSEEK_API_KEY_2=sk-backup-key-2-here
DEEPSEEK_API_KEY_3=sk-backup-key-3-here

# OxaPay Payment Configuration (Optional - for payments)
OXAPAY_API_KEY=your_oxapay_api_key_here
OXAPAY_MERCHANT_ID=your_merchant_id_here

# Eden AI API Key (Optional - for current information fetching)
# Eden AI provides current/recent code, search results, and data to DeepSeek
# DeepSeek remains the reasoning/agent layer, Eden AI acts as a tool
EDEN_AI_API_KEY=your_eden_ai_api_key_here

# Vision API Keys (Optional - for image analysis)
# FREE TIER AVAILABLE for all of these!
# Google Gemini API Key (FREE tier: 60 requests/minute)
# Get it from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here
# OR
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key_here

# Replicate API Key (FREE tier available)
# Get it from: https://replicate.com/account/api-tokens
REPLICATE_API_KEY=your_replicate_api_key_here

# OCR.space API Key (Optional - FREE tier works without key)
# Get it from: https://ocr.space/ocrapi/freekey
OCR_SPACE_API_KEY=your_ocr_space_api_key_here

# Mindee API Key (FREE: 250 IDs/month, no credit card required!)
# Get it from: https://mindee.com/product/international-id-ocr-api
# Perfect for ID scanning and data extraction!
MINDEE_API_KEY=your_mindee_api_key_here

# Elysia Tools API Key (FREE API available)
# Get it from: https://elysiatools.com/en/tools/ai-ocr-id-card-to-json
# Extracts ID card data to JSON format
ELYSIA_API_KEY=your_elysia_api_key_here

# Local OCR Libraries (FREE, no API key needed!)
# Install: pip install pytesseract easyocr
# System: apt-get install tesseract-ocr (Linux) or brew install tesseract (Mac)
# EasyOCR downloads models automatically on first use (~500MB)

# Hugging Face API Key (Optional - FREE tier available)
# Get it from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# OpenRouter API Key (Optional - for vision models)
# Get it from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Production Mode (Optional)
# Set to "true" to enable production mode (no interactive prompts)
PRODUCTION_MODE=false

